# 复制本文件为 .env 后再修改。等号两侧不要加引号或空格。

# -----------------------------------------------------------------------------
# AI 接口（必填）
# -----------------------------------------------------------------------------
# 后端会自动在 BASE_URL 后拼接 /chat/completions，请不要把该路径重复写入。
# 魔搭访问令牌在 https://modelscope.cn/ 的个人中心创建，只填令牌本身，
# 不要在 OPENAI_API_KEY 中添加 "Bearer "。
OPENAI_BASE_URL=https://api-inference.modelscope.cn/v1
OPENAI_API_KEY=

# READ_MODEL 必须支持 image_url 图像输入；CHAT_MODEL 用于对话、JSON 协调和工具调用。
# 下列模型是质量优先组合。魔搭模型清单变化时，可替换为 /v1/models 返回的完整模型 ID。
READ_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
CHAT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507

# 速度优先时可将 READ_MODEL 改成：
# READ_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 免费共享服务可能排队；单次 AI 请求超时，单位为秒，程序默认值为 120。
AI_TIMEOUT_SECONDS=180

# 本地语音通话（可选）。所有模型固定使用 CPU，首次通话会下载模型并需要较长预热时间。
# FUNASR_MODEL=paraformer-zh
# FUNASR_VAD_MODEL=fsmn-vad
# FUNASR_PUNC_MODEL=
# VOICE_MODEL_CACHE_DIR=.tmp/modelscope
# VOICE_TTS_PROVIDER=edge
# EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# MELOTTS_SPEAKER=ZH
# MELOTTS_SPEED=1.0

# -----------------------------------------------------------------------------
# 存储、上传与 AI 调度（可选；取消行首 # 后生效）
# -----------------------------------------------------------------------------
# 本地数据目录。相对路径以项目根目录为基准；Docker Compose 会固定使用 /data。
# APP_DATA_DIR=backend/data

# 单张图片和量房导入文件的最大体积，单位 MB；产品清单和模型资产另有独立上限。
# MAX_UPLOAD_MB=20

# 可选模型转换器。上传 SKP/DAE/STL/PLY/3MF/BLEND 时自动转换为 GLB。
# 建议使用 JSON 参数数组，避免路径空格和命令行转义问题；转换器必须写出 {output} 指定的 GLB。
# MODEL_CONVERTER_COMMAND=["D:\\tools\\model-converter.exe","--input","{input}","--output","{output}"]
# MODEL_CONVERSION_TIMEOUT_SECONDS=180

# Pillow 允许解码的最大像素数，提高该值会增加内存和解压缩炸弹风险。
# MAX_IMAGE_PIXELS=30000000

# 其他 AI 流程遇到 429、5xx 和网络错误时的重试次数及退避秒数。
# 平面图单次视觉识别固定不重试，避免一次操作产生多次视觉调用。
# AI_MAX_RETRIES=3
# AI_RETRY_BASE_SECONDS=0.75

# 旧版工具式视觉流程的最多轮数；当前平面图上传主路径不使用该流程。
# AI_MAX_TOOL_ROUNDS=4

# 是否把模型响应写入 APP_DATA_DIR/ai-traces。响应可能包含识别出的量房数值，
# 默认不落盘；仅在本机排错且确认数据保留策略后临时开启。
# AI_TRACE_ENABLED=false

# 旧版墙面裁片工具的并发数；当前平面图上传主路径不读取固定裁片。
# AI_WALL_CROP_CONCURRENCY=4

# -----------------------------------------------------------------------------
# 本地 OCR（可选）
# -----------------------------------------------------------------------------
# paddle：尝试调用 PaddleOCR；disabled：完全跳过本地 OCR，仅使用视觉模型。
# OCR_ENGINE=paddle

# 安装了 PaddleOCR 的 Python 解释器绝对路径。留空时只会尝试程序内置候选路径。
# PADDLEOCR_PYTHON=D:\path\to\PaddleOCR\.venv\Scripts\python.exe

# 单次 OCR 超时、缓存目录和缓存有效期。相对目录以项目根目录为基准。
# OCR_TIMEOUT_SECONDS=180
# OCR_CACHE_DIR=.tmp/ocr-fast
# OCR_CACHE_TTL_HOURS=24

# -----------------------------------------------------------------------------
# 产品语义向量检索（高级可选）
# -----------------------------------------------------------------------------
# 当前实现通过系统进程环境读取这两项，而不是从 .env 读取；标准启动方式默认关闭，
# 仍会使用 BM25 + 知识图谱检索。需要启用时，在启动后端前执行：
# $env:EMBEDDING_MODEL='BAAI/bge-small-zh-v1.5'
# $env:EMBEDDING_CACHE_DIR='.cache/fastembed'

# AI_COMPARE_TOPOLOGY_MODELS 没有业务代码引用，AI_QUALITY_TIMEOUT_SECONDS 未定义；
# 不要把这两个变量加入 .env。
