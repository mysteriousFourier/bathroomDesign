{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opc-bathroom/evidence/schema/threshold-registry.schema.json",
  "title": "Threshold Registry",
  "description": "Week 1 threshold registry. Confirmed calculation tolerances, provisional implementation thresholds, and pending business thresholds are intentionally separated.",
  "type": "object",
  "version": "1.0.0",
  "required": ["schemaVersion", "rows"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["thresholdId", "category", "parameter", "thresholdType", "value", "unit", "source", "status", "verificationImpact", "appliesTo"],
        "properties": {
          "thresholdId": {
            "type": "string",
            "pattern": "^THR-[A-Z0-9]+-[0-9]{3}$"
          },
          "category": {
            "type": "string",
            "enum": ["Geometry", "Topology", "3D Empty-Room", "Annotation", "Validation Harness"]
          },
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "thresholdType": {
            "type": "string",
            "enum": ["calculation_tolerance", "provisional_implementation", "business_threshold"]
          },
          "value": {
            "type": ["number", "string", "null"]
          },
          "unit": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["confirmed", "provisional_implementation", "pending_business_confirmation"]
          },
          "verificationImpact": {
            "type": "string",
            "enum": ["can_confirm", "provisional_only", "unverified_only"]
          },
          "appliesTo": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": { "status": { "const": "pending_business_confirmation" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "thresholdType": { "const": "business_threshold" },
                "value": { "type": "null" },
                "verificationImpact": { "const": "unverified_only" }
              }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "confirmed" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "thresholdType": { "const": "calculation_tolerance" },
                "verificationImpact": { "const": "can_confirm" }
              },
              "not": { "properties": { "value": { "type": "null" } }, "required": ["value"] }
            }
          },
          {
            "if": {
              "properties": { "status": { "const": "provisional_implementation" } },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "thresholdType": { "const": "provisional_implementation" },
                "verificationImpact": { "const": "provisional_only" }
              }
            }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
